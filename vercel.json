{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "datarylabs.com" }],
      "destination": "https://www.datarylabs.com/:path*",
      "permanent": true
    }
  ]
}
